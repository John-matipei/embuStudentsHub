# BACKEND .env FILE (LOCAL DEVELOPMENT ONLY)
# This file MUST be inside the 'backend' folder

PORT=5000
FRONTEND_URL=http://localhost:5173

# LOCAL DATABASE CONFIGURATION
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# Leave empty if you didn't set a password for MySQL
